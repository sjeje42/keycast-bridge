<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Keycast Bridge</vendor>
  <action id="fr.jeromelab.KeycastBridge.capture">
    <description>Read a selected keyboard for an OBS tutorial</description>
    <description xml:lang="fr">Lire le clavier choisi pour un tutoriel OBS</description>
    <message>Authorize Keycast Bridge to open the selected keyboard.</message>
    <message xml:lang="fr">Autoriser Keycast Bridge à ouvrir le clavier choisi.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/keycast-bridge-capture</annotate>
  </action>
</policyconfig>
